{
  "name": "multiarena",
  "version": "0.2.2",
  "description": "Terminal-native multi-model content generation — N models collaborate to produce the best document, analysis, script, or strategy",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "multiarena": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "README_CN.md",
    "CHANGELOG.md",
    "CHANGELOG_CN.md",
    "USER_GUIDE.md",
    "USER_GUIDE_CN.md",
    "web/dist/",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "llm",
    "content-generation",
    "multi-model",
    "collaboration",
    "document-generation",
    "terminal",
    "cli",
    "claude",
    "gpt",
    "gemini"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timgunnar/multiarena.git"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "build:web": "npm --prefix web run build",
    "dev:web": "npm --prefix web run dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@google/generative-ai": "^0.21.0",
    "@iarna/toml": "^2.2.5",
    "ink": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "openai": "^4.50.0",
    "react": "^18.2.0",
    "simple-git": "^3.25.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.19.19",
    "@types/react": "^18.2.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "playwright": "^1.60.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
